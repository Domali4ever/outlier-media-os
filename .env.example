# Outlier Media OS — configuration template. Copy to .env.local and fill in what you connect.
# Secrets are read server-side only (never sent to the browser, never stored in the database,
# never exported). .env.local is git-ignored. Edits are picked up without a restart.

# ---- Local runtime ---------------------------------------------------------
# HOST=127.0.0.1            # default; anything else requires ALLOW_NETWORK=1 (see README › Deployment)
# PORT=3000
# DATA_DIR=./data           # SQLite database + assets. Must be on persistent storage.
# BACKUP_DIR=./backups
# EXPORT_DIR=./exports
# COOKIE_SECURE=1           # set when served over HTTPS

# ---- AI: Anthropic Messages API (ai.structured_generation) ------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Token prices are REQUIRED before any paid job runs, so spend can be checked against your cap.
# Copy them from Anthropic's pricing page for the model you set above (per million tokens).
ANTHROPIC_PRICE_INPUT_PER_MTOK=
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=
ANTHROPIC_PRICE_CURRENCY=USD

# ---- Research retrieval: Brave Search API (research.retrieval) --------------
BRAVE_SEARCH_API_KEY=

# ---- Publishing: WordPress REST API (publish.primary) -----------------------
WP_BASE_URL=https://your-site.example
WP_USERNAME=
WP_APP_PASSWORD=
# WP_POST_STATUS=publish    # 'draft' is refused: drafts are not publications

# ---- Google (Drive import is optional; GA4 = analytics.primary) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=

# Whop commerce (sandbox first)
WHOP_COMPANY_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
WHOP_SANDBOX=true
APP_URL=http://127.0.0.1:3000
